{
  "sections": [
    { "key": "server",     "title": "Server" },
    { "key": "database",   "title": "Database (PostgreSQL)" },
    { "key": "redis",      "title": "Redis" },
    { "key": "jwt",        "title": "JWT" },
    { "key": "rate_limit", "title": "Login Protection" },
    { "key": "email",      "title": "Email (SMTP)" }
  ],
  "docker_section": { "key": "docker", "title": "Docker expose (host ports / IPs)" },

  "server": [
    { "key": "SERVER_MODE",       "desc": "Gin run mode",         "default": "release",      "choices": ["release", "debug"] },
    { "key": "SERVER_IP",         "desc": "Main server bind IP",  "default": "127.0.0.1",    "server_docker": "0.0.0.0" },
    { "key": "SERVER_PORT",       "desc": "Main server port",     "default": "3220" },
    { "key": "SERVER_DEV_IP",     "desc": "Dev server bind IP",   "default": "127.0.0.1",    "server_docker": "0.0.0.0" },
    { "key": "SERVER_DEV_PORT",   "desc": "Dev server port",      "default": "3221" },
    { "key": "ENABLE_PPROF",      "desc": "Enable pprof on dev server (debug mode only)", "default": "false", "choices": ["false", "true"] },
    { "key": "DEV_API_KEY",       "desc": "API key required for all dev server endpoints (required when SERVER_MODE != release)", "default": "" }
  ],
  "database": [
    { "key": "DB_HOST",         "desc": "PostgreSQL host",      "default": "localhost",    "infra_docker": "postgres" },
    { "key": "DB_PORT",         "desc": "PostgreSQL port",      "default": "5432" },
    { "key": "DB_USER",         "desc": "PostgreSQL user",      "default": "postgres" },
    { "key": "DB_PASSWORD",     "desc": "PostgreSQL password",  "default": "postgres" },
    { "key": "DB_NAME",         "desc": "Database name",        "default": "dx_auth" },
    { "key": "DB_SSLMODE",      "desc": "PostgreSQL SSL mode. For local host or Docker development, use disable unless your Postgres is configured for TLS.",  "default": "require",      "choices": ["require", "verify-full", "disable"] },
    { "key": "DB_MAX_OPEN_CONNS", "desc": "Maximum open PostgreSQL connections", "default": "25" },
    { "key": "DB_MAX_IDLE_CONNS", "desc": "Maximum idle PostgreSQL connections", "default": "25" },
    { "key": "DB_CONN_MAX_LIFETIME_SECONDS", "desc": "Maximum lifetime for a PostgreSQL connection (seconds)", "default": "3600" },
    { "key": "DB_CONN_MAX_IDLE_TIME_SECONDS", "desc": "Maximum idle time for a PostgreSQL connection (seconds)", "default": "900" }
  ],
  "redis": [
    { "key": "REDIS_HOST",      "desc": "Redis host",           "default": "localhost",    "infra_docker": "redis" },
    { "key": "REDIS_PORT",      "desc": "Redis port",           "default": "6379" },
    { "key": "REDIS_PASSWORD",  "desc": "Redis password",       "default": "" },
    { "key": "REDIS_CACHE_TTL", "desc": "Cache TTL (seconds)",  "default": "3600" }
  ],
  "jwt": [
    { "key": "JWT_ACCESS_KEYS_DIR",  "desc": "Subfolder name inside keys/ for access token EC keys — auto-generates a P-256 key pair per season (YYYY-sN), prunes expired seasons on startup, serves public keys at /.well-known/jwks.json", "default": "access" },
    { "key": "JWT_REFRESH_KEYS_DIR", "desc": "Subfolder name inside keys/ for refresh token EC keys — same auto-rotation behaviour as JWT_ACCESS_KEYS_DIR",                                                                                    "default": "refresh" },
    { "key": "JWT_ACCESS_EXPIRY",    "desc": "Access token lifetime (seconds)",                                                                                                                                             "default": "900" },
    { "key": "JWT_REFRESH_EXPIRY",   "desc": "Refresh token lifetime (seconds)",                                                                                                                                            "default": "2592000" }
  ],
  "rate_limit": [
    { "key": "LOGIN_MAX_ATTEMPTS", "desc": "Failed logins allowed before temporary lockout", "default": "5" },
    { "key": "LOGIN_LOCKOUT_SECONDS", "desc": "Lockout duration after too many failed logins (seconds)", "default": "900" }
  ],
  "email": [
    { "key": "EMAIL_SMTP_HOST",         "desc": "SMTP relay hostname. Leave empty to disable email sending (noop mode).",                      "default": "" },
    { "key": "EMAIL_SMTP_PORT",         "desc": "SMTP relay port.",                                                                            "default": "587" },
    { "key": "EMAIL_SMTP_USERNAME",     "desc": "SMTP auth username. Leave empty for unauthenticated relay (e.g. MailHog / local relay).",     "default": "" },
    { "key": "EMAIL_SMTP_PASSWORD",     "desc": "SMTP auth password.",                                                                         "default": "" },
    { "key": "EMAIL_FROM_ADDRESS",      "desc": "Sender address used in all transactional emails.",                                            "default": "no-reply@example.com" },
    { "key": "EMAIL_OTP_EXPIRY_SECONDS","desc": "How long a registration OTP remains valid (seconds).",                                        "default": "600" }
  ],
  "docker": [
    { "key": "DOCKER_IP",                 "desc": "IP for main server, DB, Redis", "default": "127.0.0.1" },
    { "key": "DOCKER_DEV_IP",             "desc": "IP for dev server",        "default": "127.0.0.1" },
    { "key": "DOCKER_SERVER_PORT",        "desc": "Host port → main server",     "default": "3220" },
    { "key": "DOCKER_SERVER_DEV_PORT",    "desc": "Host port → dev server",      "default": "3221" },
    { "key": "DOCKER_DB_PORT",            "desc": "Host port → PostgreSQL",      "default": "5432",  "infra_only": true },
    { "key": "DOCKER_REDIS_PORT",         "desc": "Host port → Redis",           "default": "6379",  "infra_only": true }
  ]
}
